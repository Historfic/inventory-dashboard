NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only. NEVER prefix with NEXT_PUBLIC_ (would leak the key to browsers).
ANTHROPIC_API_KEY=sk-ant-your-haiku-key-here

# --- Arbitrage leads (/arbitrage) — CLAUDE.md §19 ---
# Browser-safe: the arbitrage Supabase project (anon = SELECT only)
NEXT_PUBLIC_ARBITRAGE_SUPABASE_URL=https://your-arbitrage-project-ref.supabase.co
NEXT_PUBLIC_ARBITRAGE_SUPABASE_ANON_KEY=sb_publishable_your-key-here
# Server-side only
ARBITRAGE_N8N_API_URL=https://your-instance.app.n8n.cloud/api/v1
ARBITRAGE_N8N_API_KEY=your-n8n-api-key
ARBITRAGE_N8N_WORKFLOW_ID=your-arbitrage-workflow-id
ARBITRAGE_N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/arbitrage-sourcing
ARBITRAGE_N8N_WEBHOOK_SECRET=your-webhook-secret
ARBITRAGE_KEEPA_API_KEY=your-keepa-key
# Deploy script only (scripts/arbitrage/n8n/deploy.mjs). Never add to Vercel.
ARBITRAGE_SUPABASE_SECRET_KEY=sb_secret_your-key-here
